[server]
host = "0.0.0.0"
port = 3000
secret_key = "change-me-to-a-random-string"

[library]
music_dir = "/music"
cover_cache_dir = "/opt/zonik/cache/covers"
naming_scheme = "{artist}/{album}/{track_number} - {title}"

[database]
path = "/opt/zonik/data/zonik.db"

[redis]
url = "redis://localhost:6379/0"

[soulseek]
slskd_url = ""
slskd_api_key = ""
download_dir = "/downloads"  # legacy, no longer written to
# Local per-job staging dir for native transfers (<staging_dir>/<job_id>/...).
# Keep it on the CT's own disk: finished files are moved once into the library.
# Only this directory is ever cleaned (download_cleanup task), never download_dir.
staging_dir = "/opt/zonik/cache/staging"
# Ceiling for one transfer, in minutes. A transfer still fails after 60 s with no
# data, or 120 s waiting in the peer's queue; a slow but steady one may run this long.
transfer_max_minutes = 30
# Download queues. A job holds a search slot while it searches (jobs waiting for
# one show as "pending"), then each transfer attempt takes a transfer slot. On top
# of that, only one file is ever queued with the same peer at a time.
max_concurrent_searches = 3
max_concurrent_downloads = 4
preferred_formats = ["flac", "wav", "mp3"]
min_file_size_mb = 3
max_workers = 4
# Native Soulseek client (replaces slskd dependency)
username = ""
password = ""
listen_port = 2234
server_host = "server.slsknet.org"
server_port = 2242
use_native = false
# Sharing. With share_library on, peers can browse the library (the list is built
# from the track table at startup and every 6 h) and download from it; off, we
# report empty shares and deny every request.
share_library = true
# Files uploaded at once (never more than one per peer; the rest queue, and
# peers are told their place in the queue).
upload_slots = 2
# Total upload rate across all uploads, in KB/s. 0 = unlimited.
upload_speed_limit_kbps = 1024

[lidarr]
enabled = false
url = ""
api_key = ""
root_folder = "/music"

[lastfm]
api_key = ""
write_api_key = ""
write_api_secret = ""

[analysis]
enable_essentia = true
enable_clap = true
use_gpu = false
clap_model = "HTSAT-base"
max_analysis_workers = 2

[streaming]
max_concurrent_transcodes = 3
transcode_cache_dir = "/opt/zonik/cache/transcodes"
transcode_cache_max_mb = 500

[subsonic]
server_name = "Zonik"

[assistant]
claude_api_key = ""
claude_model = "claude-sonnet-5-5"
# claude_fast_model = "claude-haiku-5-5"   # cheap model for resolving vague song searches
# Record one ai_usage row per Claude API call (powers the AI usage dashboard)
track_ai_usage = true

# Recommendation score weights (artist_affinity, genre_match, lastfm_similar, popularity,
# novelty) are renormalised to sum to 1. w_audio_match and w_clap_similarity are accepted
# but ignored: audio_match was a constant and clap_similarity always 0 before download.
# w_artist_affinity = 0.25
# w_genre_match = 0.20
# w_lastfm_similar = 0.20
# w_popularity = 0.05
# w_novelty = 0.05
#
# Auto-download gating lives in the schedule task config: "min_score" on the
# recommendation_refresh task (default 0.5). The Last.fm global chart (lastfm_top_tracks) is
# filtered by the taste profile with its own bar, since chart entries have no similarity score:
# chart_min_score = 0.3   # or "chart_min_score" in the lastfm_top_tracks task config

# Optional: override the built-in pricing snapshot in
# backend/services/ai/pricing.py. model-id -> [input, output] USD per 1M tokens.
# [assistant.model_pricing]
# "claude-sonnet-5-5" = [2.00, 10.00]
# "claude-haiku-5-5" = [0.10, 0.50]

[kimahub]
db_url = ""  # postgresql://kima:pass@host:5432/kima

<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      "Broadcast": a compact Z between two pairs of sound arcs, the inner pair
      solid and the outer pair at 60% alpha.

      Authored in the 240-unit space shared with frontend/static/favicon.svg
      (outer group scales 240 -> 108). Only the inner 72dp of the 108dp layer
      renders, and 66dp (radius 73.3 here) is the guaranteed-safe circle. The
      outer arcs sit at radius 66 with a 4-unit half-stroke, so their furthest
      edge is at 70, inside that circle. Check anything new against it.

      This layer doubles as the monochrome (themed icon) layer, so it must read
      on its own without the background gradient.
    -->
    <group android:scaleX="0.45" android:scaleY="0.45">

        <!-- Z -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#AFA9EC"
            android:strokeWidth="13"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M98,98 L142,98 L98,142 L142,142"/>

        <!-- inner arcs, r=50, +/-40 degrees either side -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#AFA9EC"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:pathData="M158.30,87.86 A50,50 0 0,1 158.30,152.14 M81.70,152.14 A50,50 0 0,1 81.70,87.86"/>

        <!-- outer arcs, r=66, +/-34 degrees either side -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#AFA9EC"
            android:strokeAlpha="0.6"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:pathData="M174.72,83.09 A66,66 0 0,1 174.72,156.91 M65.28,156.91 A66,66 0 0,1 65.28,83.09"/>

    </group>
</vector>
